{
  "name": "youtuberadio",
  "version": "1.0.2",
  "description": "A simple Overlay for Youtube videos",
  "main": "./out/main/index.js",
  "author": "Sarah Tsangou <",
  "scripts": {
    "test": "jest --silent",
    "coverage": "jest --silent --coverage",
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "yarn run typecheck:node && yarn run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "dev:watch": "electron-vite dev --watch",
    "build": "yarn run typecheck && electron-vite build",
    "postinstall": "yarn electron-builder install-app-deps",
    "build:unpack": "yarn run build && electron-builder --dir",
   "build:win": "yarn run build && electron-builder --win",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:linux": "electron-vite build && electron-builder --linux",
    "publish": "electron-builder --publish always",
    "prepare": "husky install"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^4.0.0",
    "@tailwindcss/vite": "^4.1.10",
    "@testing-library/dom": "^10.4.1",
    "@types/react": "^19.1.8",
    "electron-packager": "^17.1.2",
    "electron-updater": "^6.3.9",
    "express": "^5.2.1",
    "prom-client": "^15.1.3",
    "jest": "^30.4.2",
    "react": "^19.1.0",
    "react-youtube": "^10.1.0",
    "tailwindcss": "^4.1.10"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.0.0",
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@tailwindcss/postcss": "^4.1.10",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.14.1",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.21",
    "electron": "^36.5.0",
    "electron-builder": "^25.1.8",
    "electron-rebuild": "^3.2.9",
    "electron-vite": "^3.1.0",
    "eslint": "^9.24.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "identity-obj-proxy": "^3.0.0",
    "jest-environment-jsdom": "^30.4.1",
    "postcss": "^8.5.6",
    "prettier": "^3.5.3",
    "react-dom": "^19.1.0",
    "ts-jest": "^29.4.11",
    "typescript": "^5.8.3",
    "vite": "^6.2.6",
    "dotenv": "^16.1.4",
    "husky": "^8.0.0"
  }
}
